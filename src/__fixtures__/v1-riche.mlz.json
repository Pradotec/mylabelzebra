{
  "app": "MyLabelZebra",
  "version": 1,
  "doc": {
    "id": "fixture-v1-riche",
    "name": "Fixture v1 riche",
    "widthIn": 4,
    "heightIn": 3,
    "dpi": 300,
    "background": "#ffffff",
    "elements": [
      {
        "id": "t-fit",
        "name": "Dénomination",
        "type": "text",
        "x": 20, "y": 10, "w": 500, "h": 60, "rotation": 0,
        "text": "Produit fictif {{Article}}",
        "fontFamily": "Arial", "fontSize": 40, "bold": true, "italic": false,
        "align": "left", "vAlign": "middle", "lineHeight": 1.1, "color": "#000000", "invert": false,
        "fit": "shrinkLine", "minFontSize": 12, "ellipsis": true,
        "role": "denomination",
        "showIf": { "field": "Article", "op": "notEmpty" }
      },
      {
        "id": "t-autoshrink-vrai",
        "type": "text",
        "x": 20, "y": 80, "w": 500, "h": 80, "rotation": 0,
        "text": "Lot : {{?Lot}} – saisi à l’impression",
        "fontFamily": "Arial", "fontSize": 30, "bold": false, "italic": false,
        "align": "left", "lineHeight": 1.1, "color": "#000000", "invert": false,
        "autoShrink": true
      },
      {
        "id": "t-autoshrink-faux",
        "type": "text",
        "x": 20, "y": 170, "w": 500, "h": 40, "rotation": 90,
        "text": "N° {{numero}} – {{date}}",
        "fontFamily": "Arial", "fontSize": 24, "bold": false, "italic": true,
        "align": "center", "lineHeight": 1.2, "color": "#000000", "invert": true,
        "autoShrink": false,
        "anchorTo": "t-autoshrink-vrai"
      },
      {
        "id": "bc",
        "type": "barcode",
        "x": 20, "y": 220, "w": 380, "h": 130, "rotation": 0,
        "value": "(01)03012345678900(10){{?Lot}}",
        "symbology": "gs1-128", "showText": true, "fontSize": 22, "color": "#000000",
        "groups": ["g-codes"]
      },
      {
        "id": "qr",
        "type": "qr", "qrType": "wifi",
        "x": 420, "y": 220, "w": 140, "h": 140, "rotation": 0,
        "value": "",
        "level": "Q", "color": "#000000",
        "wifi": { "ssid": "ReseauFictif", "password": "motdepasse-exemple", "enc": "WPA", "hidden": false },
        "groups": ["g-codes"]
      },
      {
        "id": "img",
        "type": "image",
        "x": 600, "y": 10, "w": 100, "h": 100, "rotation": 0, "flipX": true,
        "src": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=",
        "threshold": 140, "dither": false, "keepRatio": true
      },
      {
        "id": "sh",
        "type": "shape", "kind": "roundrect",
        "x": 5, "y": 5, "w": 790, "h": 590, "rotation": 0,
        "fill": "none", "stroke": "#000000", "strokeWidth": 4, "radius": 20,
        "locked": true
      },
      {
        "id": "tb",
        "type": "table",
        "x": 20, "y": 380, "w": 500, "h": 132, "rotation": 0,
        "rows": 3, "cols": 2,
        "cells": [["Nutriment", "Pour 100 g"], ["Énergie", "{{Energie}} kJ"], ["Sel", "1,2 g"]],
        "fontSize": 20, "fontFamily": "Arial", "strokeWidth": 3, "headerRow": true, "align": "left",
        "colWidths": [2, 1], "rowHeights": [1, 1, 1]
      },
      {
        "id": "mk",
        "type": "mark", "kind": "health",
        "x": 560, "y": 400, "w": 240, "h": 160, "rotation": 0,
        "country": "FR", "approval": "99.999.999", "suffix": "CE",
        "color": "#000000", "strokeWidth": 3, "fontFamily": "Arial",
        "role": "healthMark"
      },
      {
        "id": "mk-e",
        "type": "mark", "kind": "estimated",
        "x": 700, "y": 560, "w": 32, "h": 32, "rotation": 0,
        "country": "", "approval": "", "suffix": "", "color": "#000000", "strokeWidth": 0,
        "hidden": true
      }
    ],
    "numbering": { "start": 100, "step": 5, "padding": 6, "prefix": "N-", "suffix": "-X", "count": 25, "repeat": 2, "alpha": false },
    "date": { "format": "JJ/MM/AAAA", "offsetDays": 3 },
    "data": {
      "columns": ["Article", "Energie"],
      "rows": [
        { "Article": "Article A", "Energie": "1000" },
        { "Article": "Article B", "Energie": "1200" },
        { "Article": "", "Energie": "800" }
      ],
      "checked": [true, false, true],
      "copies": [2, 1, 3],
      "source": "donnees-fictives.csv"
    },
    "guides": { "x": [100, 400], "y": [50] },
    "zplRaster": false,
    "zoom": 1.5,
    "copies": 4,
    "allergensExtra": ["lupin fictif"],
    "roll": { "columns": 2, "gapMm": 3, "leftMm": 1.5 },
    "updatedAt": 1700000000000
  }
}
